{
  "name": "vereel-mcp",
  "version": "0.1.0",
  "description": "MCP server for Vereel influencer marketing: brands and companies add offers (campaigns) that creators can apply to, and search public offers, from Claude, Cursor and other AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "vereel-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/make-executable.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sync-spec": "node scripts/sync-spec.mjs",
    "prepare": "npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hans100x-dotcom/vereel-mcp.git"
  },
  "homepage": "https://www.vereel.com/en/api",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "influencer-marketing",
    "influencers",
    "creators",
    "campaigns",
    "brands",
    "vereel"
  ]
}
